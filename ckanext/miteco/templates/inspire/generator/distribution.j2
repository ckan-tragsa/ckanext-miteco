    <gmd:distributionInfo>
      <gmd:MD_Distribution>
      {% if record.get('distribution') and record['distribution']|length > 0 %}
        {% for k, v in record['distribution'].items() %}
        {% if v.get('format') %}
          <gmd:distributionFormat>
            <gmd:MD_Format>
              {% if v.get('format_uri') %}
                <gmd:name>
                  <gmx:Anchor xlink:href="{{ v.format_uri }}">{{ v.format|string|trim|e }}</gmx:Anchor>
                </gmd:name>
              {% else %}
                <gmd:name>
                  <gco:CharacterString>{{ v.format|string|trim|e }}</gco:CharacterString>
                </gmd:name>
              {% endif %}
              {% if v.get('format_version') %}
                <gmd:version>
                  <gco:CharacterString>{{ v.format_version|string|trim|e }}</gco:CharacterString>
                </gmd:version>
              {% else %}
                <gmd:version gco:nilReason="unknown"/>
              {% endif %}
            </gmd:MD_Format>
          </gmd:distributionFormat>
        {% endif %}
        {% endfor %}
        <gmd:transferOptions>
          <gmd:MD_DigitalTransferOptions>
          {% for k, v in record['distribution'].items() %}
            {% if v.get('url') %}
            <gmd:onLine>
              <gmd:CI_OnlineResource>
                <gmd:linkage>
                  <gmd:URL>{{ v.url|string|trim|e }}</gmd:URL>
                </gmd:linkage>
                <gmd:protocol>
                  <gco:CharacterString>{{ v.get('type') or 'WWW:LINK' }}</gco:CharacterString>
                </gmd:protocol>
                {% if v.get('name') %}
                <gmd:name>
                  <gco:CharacterString>{{ v.name|string|trim|e }}</gco:CharacterString>
                </gmd:name>
                {% endif %}
                {% if resource_type == "service" %}
                  <gmd:description>
                    <gmx:Anchor xlink:href="http://inspire.ec.europa.eu/metadata-codelist/OnLineDescriptionCode/accessPoint">{% if v.get('description') %}{{ v.description|string|trim|e }}{% else %}Punto de acceso al servicio{% endif %}</gmx:Anchor>
                  </gmd:description>
                {% else %}
                  {% if v.get('description') %}
                  <gmd:description>
                    <gco:CharacterString>{{ v.description|string|trim|e }}</gco:CharacterString>
                  </gmd:description>
                  {% endif %}
                {% endif %}
                {% if v.get('function') %}
                <gmd:function>
                  <gmd:CI_OnLineFunctionCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode" codeListValue="{{ v.function }}">{{ v.function }}</gmd:CI_OnLineFunctionCode>
                </gmd:function>
                {% endif %}
              </gmd:CI_OnlineResource>
            </gmd:onLine>
            {% endif %}
          {% endfor %}
          </gmd:MD_DigitalTransferOptions>
        </gmd:transferOptions>
      {% else %}
        <gmd:distributionFormat gco:nilReason="missing"/>
        <gmd:transferOptions gco:nilReason="missing"/>
      {% endif %}
      </gmd:MD_Distribution>
    </gmd:distributionInfo>
